{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yourmomsbasement/Tv-Remote_Free/docs/theme.schema.json",
  "title": "OpenRemote theme",
  "description": "A user theme for the OpenRemote app. See docs/THEMES.md.",
  "type": "object",
  "required": ["format", "version", "name"],
  "properties": {
    "format": { "const": "tv-remote-free-theme" },
    "version": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{1,64}$",
      "description": "Stable id; importing a theme with the same id replaces it. Defaults to one derived from the name."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "author": { "type": "string", "maxLength": 60 },
    "description": { "type": "string", "maxLength": 200 },
    "modes": {
      "type": "array",
      "items": { "enum": ["light", "dark"] },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Which brightness variants the theme supports. Default: both."
    },
    "colors": { "$ref": "#/$defs/palette", "description": "Shared by light and dark." },
    "light": { "$ref": "#/$defs/palette", "description": "Overrides for light mode." },
    "dark": { "$ref": "#/$defs/palette", "description": "Overrides for dark mode." },
    "shape": {
      "type": "object",
      "properties": {
        "button": { "enum": ["circle", "rounded", "square"] },
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 40 },
        "dpad": { "enum": ["circle", "rounded"] }
      },
      "additionalProperties": false
    },
    "buttonScale": { "type": "number", "minimum": 0.8, "maximum": 1.3 },
    "background": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^data:image/(png|jpeg|jpg|webp);base64,",
          "description": "Embedded image, at most 2 MB once decoded."
        },
        "fit": { "enum": ["cover", "contain", "fill"] },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "palette": {
      "type": "object",
      "properties": {
        "seed": { "$ref": "#/$defs/color" },
        "background": { "$ref": "#/$defs/color" },
        "surface": { "$ref": "#/$defs/color" },
        "button": { "$ref": "#/$defs/color" },
        "buttonIcon": { "$ref": "#/$defs/color" },
        "accentButton": { "$ref": "#/$defs/color" },
        "accentButtonIcon": { "$ref": "#/$defs/color" },
        "dpadRing": { "$ref": "#/$defs/color" },
        "ok": { "$ref": "#/$defs/color" },
        "okText": { "$ref": "#/$defs/color" }
      },
      "additionalProperties": false
    }
  }
}
